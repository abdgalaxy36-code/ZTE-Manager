<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ZTE Router Manager"
            android:textColor="#1E293B"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <!-- كارت حالة الاتصال والمعلومات -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="الحالة: جاهز"
                android:textColor="#2563EB"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="اضغط تحديث لقراءة البيانات..."
                android:textColor="#475569"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"/>

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="تحديث وجلب البيانات"
                android:backgroundTint="#2563EB"
                android:textColor="#FFFFFF"
                android:layout_marginTop="12dp"/>
        </LinearLayout>

        <!-- كارت قفل الترددات -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="قفل الترددات (LTE Bands)"
                android:textColor="#1E293B"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btnB1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="B1"
                    android:backgroundTint="#0F172A"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/btnB3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="B3"
                    android:backgroundTint="#0F172A"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btnB8"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="B8"
                    android:backgroundTint="#0F172A"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/btnB40"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="B40"
                    android:backgroundTint="#0F172A"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnReset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="إعادة الوضع التلقائي (جميع الترددات)"
                android:backgroundTint="#475569"/>
        </LinearLayout>

        <!-- كارت الإعدادات السريعة -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="إعدادات النظام"
                android:textColor="#1E293B"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btn4GOnly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="تثبيت 4G Only"
                android:backgroundTint="#059669"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnReboot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="إعادة تشغيل الراوتر (Reboot)"
                android:backgroundTint="#DC2626"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
